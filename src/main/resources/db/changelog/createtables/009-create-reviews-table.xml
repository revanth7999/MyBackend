<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-create-reviews-table" author="claude">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="REVIEWS"/>
            </not>
        </preConditions>
        <createTable tableName="REVIEWS">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_review_user" referencedTableName="captain" referencedColumnNames="id"/>
            </column>
            <column name="restaurant_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_review_restaurant" referencedTableName="RESTAURANTS" referencedColumnNames="id"/>
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
