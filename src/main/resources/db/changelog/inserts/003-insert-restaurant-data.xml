<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <!-- INSERT RESTAURANTS -->
    <changeSet id="1"
               author="Revanth N">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*)
                FROM restaurants
            </sqlCheck>
        </preConditions>
        <insert tableName="restaurants">
            <column name="name"
                    value="Paradise Biryani"/>
            <column name="cuisine"
                    value="Hyderabadi"/>
            <column name="is_open"
                    valueBoolean="true"/>
            <column name="phone"
                    value="9876543210"/>
            <column name="rating"
                    valueNumeric="4.5"/>
            <column name="street"
                    value="MG Road"/>
            <column name="city"
                    value="Hyderabad"/>
            <column name="state"
                    value="Telangana"/>
            <column name="zipcode"
                    value="500001"/>
        </insert>
        <insert tableName="restaurants">
            <column name="name"
                    value="Pizza Palace"/>
